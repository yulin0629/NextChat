# ============================================================
# Yician Chat - Cloudflare Pages Production Environment Config
# ============================================================

# 1. Cloudflare Pages Build Engine Config
NODE_VERSION=20.1
NEXT_TELEMETRY_DISABLE=1

# 2. Sub2API Gateway Backend URL & Key
# (Mapped via Cloudflare Tunnel to local Sub2API port 18662)
# NOTE: Do NOT add trailing /v1 because NextChat automatically appends /v1/...
BASE_URL=https://sub2api.yician0629.com

# P0 Security: Set your actual API Key in Cloudflare Pages Dashboard (Environment Variables), NOT in Git!
OPENAI_API_KEY=sk-your-sub2api-key-here

# 3. Model Whitelist & Display Names (Next-Gen Flagship Lineup)
CUSTOM_MODELS=-all,+gpt-5.6-sol=GPT-5.6 Sol,+gpt-5.6-terra=GPT-5.6 Terra,+gpt-5.6-luna=GPT-5.6 Luna,+claude-sonnet-5=Claude Sonnet 5,+claude-opus-5=Claude Opus 5,+claude-fable-5-1=Claude Fable 5.1,+gemini-3.7-flash-high=Gemini 3.7 Flash (High),+gemini-3.7-flash-medium=Gemini 3.7 Flash (Med),+gemini-3.7-flash-low=Gemini 3.7 Flash (Low),+openai/qwen3.8-flash=Qwen 3.8 Flash,+glm-5.3=GLM-5.3,+openai/glm-5.3-flash=GLM-5.3 Flash,+grok-4.6=Grok 4.6,+k3-256k=Kimi K3 (256K),+gpt-image-2=GPT Image 2,+qwen3.8-27b=Qwen 3.8 27B Obliterated
DEFAULT_MODEL=claude-sonnet-5

# 4. Security & Privacy Controls
HIDE_USER_API_KEY=1
DISABLE_FAST_LINK=1
ENABLE_BALANCE_QUERY=0

# 5. Optional Access Password (Secondary protection)
# CODE=your-password
